# Testnet deployment values (verified on-chain 2026-10-17). Copy per chain into your shell env.
# Never commit a real private key; pass it with --private-key / --account at deploy time.

# --- Mezo testnet (hub) — chainId 31611, Wormhole chain 50 ---
MEZO_RPC=https://rpc.test.mezo.org
MUSD=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
MEZO=0x7B7c000000000000000000000000000000000001
# Pyth Core on Mezo testnet after the 2026-08-26 cutover (fee 0), pushed about hourly by Mezo's pusher
# for MUSD/MEZO/USDC (not ETH). 0x2880… is no longer updated.
PYTH=0x933aDeC2C7624b11E4B2b80ACE15BF9a71a31315
# Supra DORA pull contract: keyless signed proofs from https://rpc-testnet-dora-2.supra.com/get_proof
SUPRA_PULL=0x443A0f4Da5d2fdC47de3eeD45Af41d399F0E5702
MEZO_WORMHOLE=0x268557122Ffd64c85750d630b716471118F323c8
MUSD_FEED=0x0617a9b725011a126a2b9fd53563f4236501f32cf76d877644b943394606c6de
MEZO_FEED=0x80beaaedbdd228e77c5d62dfcd74b0305674b7e27a5cc6a46e71bd3a696826df
ETH_FEED=0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace
USDC_FEED=0xeaa020c61cc479712813461ce153894a96a6c00b21ed0cfc2798d1f9a9e9c94a
# Per-feed oracle policy. Push feeds: max age above the longest heartbeat gap seen since the cutover
# (3,668 s). Pull legs: 120 s. Confidence caps from the observed MUSD/MEZO distributions (p99 2.87%).
MUSD_MAX_AGE=3900
MEZO_MAX_AGE=3900
USDC_MAX_AGE=3900
ETH_MAX_AGE=120
MUSD_MAX_CONF_BPS=500
MEZO_MAX_CONF_BPS=500
ETH_SUPRA_PAIR=19
USDC_SUPRA_PAIR=89
SUPRA_MAX_AGE=120
DIVERGENCE_BPS=150

