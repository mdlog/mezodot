# Copy to services/agent/.env (git-ignored, excluded from Docker builds). `pnpm start` and docker compose
# both read it; variables set inline on the command line win. Every value is validated at startup: the agent
# refuses to start and lists what is wrong instead of running with a fallback (services/agent/README.md).

# Required: devnet | testnet
MEZODOT_ENV=testnet

# Optional RPC overrides (defaults come from @mezodot/sdk networks). Comma-separate several URLs for a fallback
# transport (tried in order). URLs never appear in logs or API errors, only their host.
# RPC_MEZO_TESTNET=https://rpc.test.mezo.org
# RPC_BASE_SEPOLIA=https://sepolia.base.org
# RPC_ETH_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com

# Keeper wallet: 32-byte hex key (0x optional). It needs BTC on Mezo for gas, ETH on the spokes for release relays,
# and MUSD/MEZO to repay liquidations. Leave empty to run read-only.
KEEPER_PRIVATE_KEY=
# Comma-separated subset of relayer,liquidator,risk,http,oracle (unknown names are rejected).
AGENT_MODULES=relayer,liquidator,risk,http,oracle
# Relayer interval (ms, 500..600000); the liquidator runs at twice this.
POLL_MS=6000
# Minimum liquidation profit (USD) after gas, fees and realising the seized collateral (Tigris price for BTC).
MIN_PROFIT_USD=1
# Seized BTC that Tigris would not buy back for at least the repaid amount: hold = liquidate anyway and keep the
# BTC until a sale covers its cost (protects the protocol, ties up keeper inventory); skip = leave the account.
# LIQUIDATE_UNSELLABLE=hold
# Largest discount to the oracle value accepted when selling seized collateral on Tigris (bps).
# MAX_SALE_DISCOUNT_BPS=500

# Keeper native balance below which /health reports degraded (whole BTC on Mezo, ETH on spokes).
# MIN_GAS_BALANCE_MEZO_TESTNET=0.0001
# MIN_GAS_BALANCE_BASE_SEPOLIA=0.002
# MIN_GAS_BALANCE_ETH_SEPOLIA=0.01
# Receives a JSON POST whenever a health check fails or recovers (Slack/Discord-compatible `text`/`content`).
# ALERT_WEBHOOK_URL=
# Deadline for every external HTTP request: Wormholescan, Supra, Hermes, CoinGecko, the alert webhook (ms).
# FETCH_TIMEOUT_MS=8000
# How long a keeper transaction may stay unmined before it is re-sent at the same nonce with higher fees (ms).
# TX_RECEIPT_TIMEOUT_MS=90000

# HTTP API (web app + oracle relay). Binds to 127.0.0.1 unless HTTP_HOST is set; put it behind HTTPS
# and point the web app's VITE_AGENT_URL at it. The web app needs /oracle/update for ETH/USDC/BTC actions.
HTTP_PORT=8787
# HTTP_HOST=0.0.0.0

# Oracle watchdog interval (ms): /oracle/health and the MCP get_oracle_health tool.
ORACLE_WATCH_MS=30000
# Optional Pyth API key: enables the server-side pusher on testnet (ETH and BTC Pyth legs; MUSD/MEZO/USDC only if
# the key is entitled to those feeds, which the default key is not: the pusher logs "not entitled" and retries
# hourly, and MUSD/MEZO then rely on Mezo's own pusher). Needs KEEPER_PRIVATE_KEY. Ignored on the devnet.
# Server-side only: never put it in a VITE_* variable, never commit this file, never paste it anywhere.
PYTH_API_KEY=
# HERMES_URL=https://hermes.pyth.network
# Supra DORA proof endpoint (default: the hub network's testnet endpoint).
# SUPRA_PROOF_URL=https://rpc-testnet-dora-2.supra.com/get_proof
# Signed-VAA sources: Wormholescan first, then any guardian REST endpoints (same /v1/signed_vaa API), in order.
# WORMHOLESCAN_API=https://api.testnet.wormholescan.io
# WORMHOLE_VAA_APIS=

# MCP write tools (trigger_liquidation, relay_message) execute only when true. Over HTTP they also
# need MCP_TOKEN (>= 16 chars), sent as "Authorization: Bearer <token>" on every /mcp request.
# With HTTP_HOST other than loopback, /mcp is off unless MCP_TOKEN is set.
MCP_ALLOW_WRITE=false
MCP_TOKEN=
# Extra Host headers accepted on /mcp (e.g. agent.example.com) and browser origins allowed to call it
# (default: none). Comma-separated.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
