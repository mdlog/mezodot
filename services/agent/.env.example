# devnet | testnet
MEZODOT_ENV=testnet
# Optional RPC overrides (defaults come from @mezodot/sdk networks)
# RPC_MEZO_TESTNET=https://rpc.test.mezo.org
# RPC_BASE_SEPOLIA=https://sepolia.base.org
# RPC_ETH_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
# Keeper wallet (needs BTC on Mezo for gas, ETH on spokes for release relays, MUSD/MEZO to liquidate).
# Leave empty to run read-only.
KEEPER_PRIVATE_KEY=
AGENT_MODULES=relayer,liquidator,risk,http,oracle
POLL_MS=6000
MIN_PROFIT_USD=1

# HTTP API (web app + oracle relay). Binds to 127.0.0.1 unless HTTP_HOST is set; put it behind HTTPS
# and point the web app's VITE_AGENT_URL at it. The web app needs /oracle/update for ETH/USDC actions.
HTTP_PORT=8787
# HTTP_HOST=0.0.0.0

# Oracle watchdog interval (ms): /oracle/health and the MCP get_oracle_health tool.
ORACLE_WATCH_MS=30000
# Optional Pyth API key: enables the server-side pusher (ETH's Pyth leg; MUSD/MEZO/USDC when Mezo's
# pusher lags). Server-side only: never put it in a VITE_* variable, never serve it.
PYTH_API_KEY=
# HERMES_URL=https://hermes.pyth.network

# MCP write tools (trigger_liquidation, relay_message) execute only when true. Over HTTP they also
# need MCP_TOKEN (>= 16 chars), sent as "Authorization: Bearer <token>" on every /mcp request.
MCP_ALLOW_WRITE=false
MCP_TOKEN=
# Extra Host headers accepted on /mcp (e.g. agent.example.com) and browser origins allowed to call it
# (default: none). Comma-separated.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
