# Mezodot web app configuration (Vite reads apps/web/.env, .env.local, .env.<mode>).
# `vite build` refuses to bundle when a required value is missing or points at localhost,
# unless VITE_MEZODOT_ENV=devnet. `vite dev` falls back to the local defaults below.

# testnet (default) | devnet
VITE_MEZODOT_ENV=testnet

# Mezodot agent HTTP API: Supra price proofs, relay status, KPIs, risk report. Required for builds.
# e.g. https://agent.example.org (dev default: http://127.0.0.1:8787)
VITE_AGENT_URL=

# WalletConnect / Reown project id (cloud.reown.com). Required for builds; "none" builds without WalletConnect
# (browser-extension and Bitcoin wallets only: the MetaMask entry needs it for its QR code, so an installed MetaMask
# shows up through EIP-6963 discovery instead).
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: let a production build use localhost services (local preview of a testnet build only).
# VITE_ALLOW_LOCALHOST=true

# Optional: hostnames that may reach `vite dev` / `vite preview` (e.g. a tunnel to a test box), comma-separated.
# Not for hosting: serve the build with `pnpm serve:web` (scripts/serve-web.ts).
# DEV_PUBLIC_HOSTS=dev.example.org

# Optional RPC endpoints, comma-separated, tried in order before each chain's public default.
# VITE_RPC_URL_MEZO_TESTNET=https://rpc.example.org/mezo
# VITE_RPC_URL_BASE_SEPOLIA=https://base-sepolia.example.org
# VITE_RPC_URL_ETH_SEPOLIA=https://sepolia.example.org

# Optional Wormholescan API base for signed VAAs (default https://api.testnet.wormholescan.io).
# VITE_WORMHOLESCAN_API=https://api.testnet.wormholescan.io
